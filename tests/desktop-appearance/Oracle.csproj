<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DesktopSource Condition="'$(DesktopSource)' == ''">C:/Temp/ExcelLight</DesktopSource>
    <DesktopBin Condition="'$(DesktopBin)' == ''">$(DesktopSource)/tests/ExcelLite.Tests/bin/Release/net10.0</DesktopBin>
    <BaseOutputPath>../../test-results/desktop-appearance/bin/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(DesktopBin)/*.dll" />
    <Compile Include="$(DesktopSource)/tests/ExcelLite.Tests/FontFillChecks.cs" Link="FontFillChecks.cs" />
    <Compile Include="$(DesktopSource)/tests/ExcelLite.Tests/FormatPainterChecks.cs" Link="FormatPainterChecks.cs" />
  </ItemGroup>
</Project>
